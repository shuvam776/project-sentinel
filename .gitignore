# ==============================================================================
# Sentinel - Enterprise Git Ignore Configuration
# Protects secrets, build caches, and media while ensuring all prod files are tracked
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (Never commit secrets to GitHub)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.*
*.local
firebase_service_account*.json
*service_account*.json
service-account*.json
google-services.json

# ------------------------------------------------------------------------------
# 2. Node & Frontend Build Artifacts (Next.js)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
*.tsbuildinfo
next-env.d.ts

# NPM / Yarn / PNPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Python & Backend Virtual Environments
# ------------------------------------------------------------------------------
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
**/ENV/

# Byte-compiled / optimized files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Pytest & Code Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# ------------------------------------------------------------------------------
# 4. Databases & Storage (Keep directories via .gitkeep, ignore runtime files)
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
!**/test_sample.mp4

# Data directories: ignore uploaded/extracted media, preserve folder structures
data/uploads/*
!data/uploads/.gitkeep
data/frames/*
!data/frames/.gitkeep
data/clips/*
!data/clips/.gitkeep
data/thumbnails/*
!data/thumbnails/.gitkeep

backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/frames/*
!backend/data/frames/.gitkeep
backend/data/clips/*
!backend/data/clips/.gitkeep
backend/data/thumbnails/*
!backend/data/thumbnails/.gitkeep
backend/data/*.db
backend/data/*.sqlite
!backend/data/.gitkeep
!backend/data/test_sample.mp4

# ------------------------------------------------------------------------------
# 5. Machine Learning Weights & Deep Learning Caches
# ------------------------------------------------------------------------------
*.pth
*.pt
*.bin
*.onnx
*.safetensors
.cache/
**/.cache/
torch_cache/
huggingface/
checkpoints/

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Specific
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vscode/
**/.vscode/
.idea/
**/.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
